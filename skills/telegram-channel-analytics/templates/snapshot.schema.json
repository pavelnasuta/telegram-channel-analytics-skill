{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot.schema.json",
  "title": "Append-only public observation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "collected_at",
    "source",
    "method",
    "methodology_version",
    "values",
    "missing_values"
  ],
  "anyOf": [
    {"required": ["post_id"]},
    {"required": ["channel_id"]}
  ],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "methodology_version": {"type": "string", "minLength": 1},
    "post_id": {"type": "string", "minLength": 1},
    "channel_id": {"type": "string", "minLength": 1},
    "values": {"type": "object"},
    "missing_values": {"type": "array", "items": {"type": "string"}}
  }
}
